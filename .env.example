# --- Сценарий ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Локальная LLM (Ollama / LM Studio / vLLM) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API=native              # native (Ollama) или openai (LM Studio, vLLM)
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_SCRIPT_MODEL=           # сценарист; пусто = OLLAMA_MODEL
OLLAMA_DIRECTOR_MODEL=         # режиссёр; после обучения: qwen2.5-director-v1
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=3000
DIRECTOR_TIMEOUT=180

# --- Озвучка ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Визуал ---
PEXELS_API_KEY=
PIXABAY_API_KEY=
RUNWAY_API_KEY=
LUMA_API_KEY=
HAIPER_API_KEY=

# --- Рендер ---
# Шрифт субтитров (должен быть установлен в системе)
SUBTITLE_FONT=Arial

# --- Движок motion_gfx (визуал в стиле референсов, без GPU) ---
MOTION_WIDTH=720          # ширина внутреннего рендера; итоговое видео всегда 1080x1920 (720 быстрее, 1080 чётче)
MOTION_FPS=30
# MOTION_FONT=C:/Windows/Fonts/ariblk.ttf        # жирный шрифт с кириллицей; по умолчанию ищется автоматически
# MOTION_FONT_MONO=C:/Windows/Fonts/consolab.ttf

# --- Художник сцен (новая сцена под фразу) ---
# OLLAMA_SCENE_MODEL=qwen2.5:14b   # модель для сцен; пусто = OLLAMA_MODEL (не дообученный режиссёр)
SCENE_DESIGNER_WORKERS=2           # параллельных запросов к LLM
# SCENE_CACHE_DIR=work/scene_cache # куда кэшируются готовые описания сцен
